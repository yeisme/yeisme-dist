{
  "schema_version": "yeisme.dist_verify_policy.v1",
  "product": "credentialctl",
  "source_repo": "yeisme/credentialctl",
  "channel": "stable",
  "eligible_tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "exclude_prerelease": true,
  "expected_assets": [
    "credentialctl_{version}_darwin_aarch64.tar.gz",
    "credentialctl_{version}_darwin_x86_64.tar.gz",
    "credentialctl_{version}_linux_aarch64.tar.gz",
    "credentialctl_{version}_linux_x86_64.tar.gz",
    "credentialctl_{version}_windows_x86_64.zip"
  ],
  "required_assets": ["checksums.txt", "release-manifest.json"],
  "allowed_extra_assets": [
    "{expected_archive}.spdx.json",
    "CHANGELOG.md",
    "config.yaml",
    "digests.txt"
  ],
  "source_revision_required": true,
  "checksums": {
    "required": true,
    "algorithm": "sha256",
    "must_cover": "expected_assets"
  },
  "provenance": {
    "sbom_required_per_archive": true,
    "attestation": {
      "expected": "github-attestation",
      "enforcement": "record-only"
    }
  },
  "handoff": {
    "expected_schema_version": "yeisme.product_release_handoff.v1",
    "correlation_fields": ["channel", "release_tag", "source_revision", "handoff_sha256"]
  }
}
